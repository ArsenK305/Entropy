# Copy to .env.docker and fill only the values needed by the Docker career workspace.
# This file is for local development only and is ignored by Git.
ENTROPY_DOCKER_MODE=demo
ENTROPY_DOCKER_MODEL=gpt-6.1-sol
ENTROPY_DOCKER_OPENAI_API_KEY=
# Both values are required to enable RAG; token must match n8n trigger Header Auth.
ENTROPY_DOCKER_RAG_SEARCH_WEBHOOK_URL=
ENTROPY_DOCKER_RAG_WEBHOOK_TOKEN=
ENTROPY_DOCKER_MINIAPP_PREVIEW=1
ENTROPY_DOCKER_TELEGRAM_POLLING=0
ENTROPY_DOCKER_MAX_OUTPUT_TOKENS=1200
ENTROPY_DOCKER_VELTRICS_MAX_OUTPUT_TOKENS=800
ENTROPY_DOCKER_PSYCHE_MAX_OUTPUT_TOKENS=600
ENTROPY_DOCKER_DB_PASSWORD=entropy-local-demo-only
ENTROPY_DOCKER_BACKEND_PORT=8765
ENTROPY_DOCKER_FRONTEND_PORT=5174

