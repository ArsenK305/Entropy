FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 entropy

COPY app.py alembic.ini ./
COPY AGENTS.md LEARNING.md ./
COPY docs/CHARTER.md docs/MVP.md ./docs/
COPY migrations ./migrations
COPY entropy_app ./entropy_app

USER 10001:10001
EXPOSE 8765

CMD ["python", "app.py"]

