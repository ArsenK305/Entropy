        "jsCode": "const files = $('Chunk and prepare points').all().map(item => item.json);\nconst points = files.flatMap(file => file.points ?? []);\nreturn [{ json: { file_count: files.length, chunk_count: points.length, scopes: [...new Set(files.map(file => file.scope))], points } }];"
      },
