    {
      "parameters": {
        "jsCode": "function newUuid() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {\n    const r = Math.floor(Math.random() * 16);\n    return (c === 'x' ? r : (r & 0x3) | 0x8).toString(16);\n  });\n}\nfunction stableUuid(value) {\n  const seeds = [2166136261, 2246822519, 3266489917, 668265263];\n  const parts = seeds.map((seed, seedIndex) => {\n    let hash = seed >>> 0;\n    const input = seedIndex + ':' + value;\n    for (let i = 0; i < input.length; i++) {\n      hash ^= input.charCodeAt(i);\n      hash = Math.imul(hash, 16777619) >>> 0;\n      hash ^= hash >>> 13;\n    }\n    return hash.toString(16).padStart(8, '0');\n  });\n  let hex = parts.join('');\n  hex = hex.slice(0, 12) + '4' + hex.slice(13);\n  const variant = ((parseInt(hex[16], 16) & 3) | 8).toString(16);\n  hex = hex.slice(0, 16) + variant + hex.slice(17);\n  return hex.slice(0, 8) + '-' + hex.slice(8, 12) + '-' + hex.slice(12, 16) + '-' + hex.slice(16, 20) + '-' + hex.slice(20);\n}\n\nconst output = [];\nfor (const item of $input.all()) {\n  const file = item.json ?? {};\n  const scope = file.scope;\n  const sourceId = typeof file.id === 'string' ? file.id : '';\n  const title = typeof file.name === 'string' ? file.name : 'Без названия';\n  const text = typeof file.extractedText === 'string' ? file.extractedText.trim() : '';\n  if (!sourceId || !['career', 'entropy_product'].includes(scope) || !text) continue;\n\n  const chunks = [];\n  const chunkSize = 2200;\n  const overlap = 250;\n  let start = 0;\n  while (start < text.length) {\n    let end = Math.min(start + chunkSize, text.length);\n    if (end < text.length) {\n      const boundary = text.lastIndexOf(' ', end);\n      if (boundary > start + Math.floor(chunkSize * 0.6)) end = boundary;\n    }\n    const content = text.slice(start, end).trim();\n    if (content) chunks.push(content);\n    if (end >= text.length) break;\n    start = Math.max(start + 1, end - overlap);\n  }\n\n  const points = chunks.map((content, index) => ({\n    id: newUuid(),\n    vector: { text: 'passage: ' + content, model: 'intfloat/multilingual-e5-small' },\n    payload: {\n      scope,\n      source_id: sourceId,\n      title,\n      content,\n      kind: 'drive',\n      file_id: sourceId,\n      file_name: title,\n      source_url: file.webViewLink ?? null,\n      modified_time: file.modifiedTime ?? null,\n      source_version: file.version ?? null,\n      chunk_index: index\n    }\n  }));\n  if (points.length) output.push({ json: { source_id: sourceId, scope, title, points, chunk_count: points.length } });\n}\nreturn output;"
      },
