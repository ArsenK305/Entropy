ENTROPY_DATABASE_URL=postgresql+psycopg://entropy_app:replace_me@127.0.0.1:5432/entropy_dev

# Telegram Mini App. Add real credentials only to the ignored local .env file.
TELEGRAM_BOT_TOKEN=

# Optional private-chat polling. The bot handles /start, /help, and product questions.
# Product questions use entropy_product RAG; live mode makes one OpenAI call.
# Set the public Telegram Mini App URL and explicitly enable polling; keep off if
# another process or webhook already receives updates for this bot.
TELEGRAM_MINIAPP_URL=
ENTROPY_TELEGRAM_POLLING=0

# Entropy mode: demo works without an API key; live requires OPENAI_API_KEY.
ENTROPY_MODE=demo
OPENAI_API_KEY=
ENTROPY_MODEL=gpt-6.1-sol
ENTROPY_MAX_OUTPUT_TOKENS=1200
VELTRICS_MAX_OUTPUT_TOKENS=800

# Local browser preview only. Do not enable when exposing the app through a public tunnel.
ENTROPY_MINIAPP_PREVIEW=1

# n8n Webhook URL. For testing, use /webhook-test/... while n8n is listening;
# after publishing, switch to the production /webhook/... URL.
ENTROPY_N8N_WEBHOOK_URL=

# Shared secret for n8n callbacks to POST /api/observability/events.
ENTROPY_N8N_EVENT_TOKEN=

# RAG search webhook in n8n. Both this URL and the matching token below are
# required; use /webhook/ when activated or /webhook-test/ while n8n is listening.
ENTROPY_RAG_SEARCH_WEBHOOK_URL=
# Shared Header Auth token. Keep it equal to the n8n credential and set to
# "disabled" or empty only to turn off RAG requests.
ENTROPY_RAG_WEBHOOK_TOKEN=

# Maximum Psyche reviewer output; called only after a Veltrics handoff (default 600).
PSYCHE_MAX_OUTPUT_TOKENS=600

# Optional local API binding. Do not bind to 0.0.0.0 unless network exposure is intended.
ENTROPY_HOST=127.0.0.1
ENTROPY_PORT=8765
