ENTROPY_DATABASE_URL=postgresql+psycopg://entropy_app:replace_me@127.0.0.1:5432/entropy_dev

# Telegram Mini App. Keep the real bot token in PyCharm Run Configuration.
TELEGRAM_BOT_TOKEN=

# Local browser preview only. Do not enable when exposing the app through a public tunnel.
ENTROPY_MINIAPP_PREVIEW=0

# Optional active n8n Webhook URL for test orders.
ENTROPY_N8N_WEBHOOK_URL=

# Shared secret for n8n callbacks to POST /api/observability/events.
ENTROPY_N8N_EVENT_TOKEN=
